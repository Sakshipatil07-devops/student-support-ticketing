// Student Support & Ticket Management System
// Data model: users/roles, tickets, SLA policy, activity history, comments.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  AGENT
  MANAGER
  ADMIN
}

enum Department {
  FEES
  ATTENDANCE
  ID_CARDS
  DOCUMENTS
  CERTIFICATES
  GENERAL
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Status {
  OPEN
  IN_PROGRESS
  PENDING_STUDENT
  ESCALATED
  RESOLVED
  CLOSED
  REOPENED
}

enum ActivityAction {
  CREATED
  ASSIGNED
  REASSIGNED
  STATUS_CHANGED
  PRIORITY_CHANGED
  COMMENT_ADDED
  INTERNAL_NOTE_ADDED
  ESCALATED
  SLA_BREACHED
  PENDING_SET
  PENDING_CLEARED
  RESOLVED
  CLOSED
  REOPENED
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  department   Department? // set for AGENT (and optionally MANAGER) — determines queue ownership
  studentCode  String?  // roll number / student id, only for STUDENT role
  createdAt    DateTime @default(now())

  ticketsRaised   Ticket[]      @relation("Requester")
  ticketsAssigned Ticket[]      @relation("Assignee")
  comments        Comment[]
  activities      ActivityLog[]
}

model SlaPolicy {
  id                 String   @id @default(cuid())
  priority           Priority @unique
  firstResponseMins  Int      // target minutes to first staff response
  resolutionMins     Int      // target minutes to resolution
  updatedAt          DateTime @updatedAt
}

model Ticket {
  id             String     @id @default(cuid())
  ticketNumber   String     @unique
  subject        String
  description    String
  category       Department
  priority       Priority   @default(MEDIUM)
  status         Status     @default(OPEN)

  requesterId    String
  requester      User       @relation("Requester", fields: [requesterId], references: [id])

  assigneeId     String?
  assignee       User?      @relation("Assignee", fields: [assigneeId], references: [id])

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  responseDueAt  DateTime            // SLA target for first staff response
  respondedAt    DateTime?           // when first staff response actually happened
  dueAt          DateTime            // SLA target for resolution (moves if paused)
  resolvedAt     DateTime?
  closedAt       DateTime?

  pendingSince   DateTime?           // non-null while clock is paused (awaiting student)
  totalPausedMs  BigInt    @default(0)

  escalationLevel Int      @default(0) // 0 none, 1 escalated to manager, 2 escalated to admin
  escalatedAt     DateTime?
  slaBreached     Boolean  @default(false)
  reopenCount     Int      @default(0)

  comments   Comment[]
  activities ActivityLog[]

  @@index([status])
  @@index([assigneeId])
  @@index([category])
  @@index([dueAt])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId   String
  author     User     @relation(fields: [authorId], references: [id])
  body       String
  isInternal Boolean  @default(false) // internal staff note, hidden from student
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model ActivityLog {
  id        String         @id @default(cuid())
  ticketId  String
  ticket    Ticket         @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?          @relation(fields: [actorId], references: [id])
  action    ActivityAction
  fromValue String?
  toValue   String?
  note      String?
  createdAt DateTime       @default(now())

  @@index([ticketId])
}
